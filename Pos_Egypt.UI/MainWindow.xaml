<Window x:Class="HeCashier.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HeCashier" Height="720" Width="1200" MinHeight="560" MinWidth="900"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource NavigationBrush}" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="HeCashier" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="نظام إدارة نقاط البيع" Foreground="{DynamicResource MutedTextBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="{Binding CurrentUserDisplay}" Margin="0,0,24,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CurrentDateTime}" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource NavigationBrush}" Padding="20,10">
            <Grid>
                <TextBlock Text="{Binding ShiftStatus}" Foreground="{DynamicResource MutedTextBrush}"/>
                <TextBlock Text="الإصدار التأسيسي - العمل دون اتصال" HorizontalAlignment="Left" Foreground="{DynamicResource MutedTextBrush}"/>
            </Grid>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <ScrollViewer Grid.Column="0" Background="{DynamicResource NavigationBrush}">
                <ItemsControl ItemsSource="{Binding NavigationItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Title}" Command="{Binding Command}" Style="{DynamicResource NavigationButtonStyle}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Border Grid.Column="1" Padding="32" Background="{DynamicResource WindowBackgroundBrush}">
                <ContentControl Content="{Binding CurrentView}"/>
            </Border>
        </Grid>
    </DockPanel>
</Window>
