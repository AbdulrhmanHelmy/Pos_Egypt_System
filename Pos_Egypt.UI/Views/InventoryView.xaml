<UserControl x:Class="HeCashier.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="280"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="المنتجات والمخزون" FontSize="27" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12"/>
        <StackPanel Grid.Row="1">
            <DockPanel Margin="0,0,0,10">
                <Button Content="بحث" Command="{Binding SearchCommand}" Padding="18,7" DockPanel.Dock="Left"/>
                <CheckBox Content="أصناف منخفضة المخزون" IsChecked="{Binding LowStockOnly}" VerticalAlignment="Center" Margin="12,0"/>
                <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategoryFilter}" DisplayMemberPath="Name" Width="170" Margin="8,0"/>
                <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" MinWidth="260" ToolTip="بحث بالاسم أو الباركود أو الكود"/>
            </DockPanel>
            <UniformGrid Columns="3" Margin="0,0,0,12">
                <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="14" Margin="3"><StackPanel><TextBlock Text="إجمالي الأصناف" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock Text="{Binding TotalProductCount}" FontSize="20" FontWeight="Bold"/></StackPanel></Border>
                <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="14" Margin="3"><StackPanel><TextBlock Text="قيمة المخزون بالتكلفة" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock Text="{Binding TotalCostValue, StringFormat={}{0:N2}}" FontSize="20" FontWeight="Bold"/></StackPanel></Border>
                <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="14" Margin="3"><StackPanel><TextBlock Text="قيمة المخزون بسعر البيع" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock Text="{Binding TotalSellingValue, StringFormat={}{0:N2}}" FontSize="20" FontWeight="Bold"/></StackPanel></Border>
            </UniformGrid>
        </StackPanel>
        <DataGrid Grid.Row="2" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="الكود" Binding="{Binding Code}"/>
                <DataGridTextColumn Header="اسم الصنف" Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="القسم" Binding="{Binding Category.Name}"/>
                <DataGridTextColumn Header="الوحدة" Binding="{Binding Unit.Name}"/>
                <DataGridTextColumn Header="سعر الشراء" Binding="{Binding PurchasePrice, StringFormat={}{0:N2}}"/>
                <DataGridTextColumn Header="سعر البيع" Binding="{Binding SellingPrice, StringFormat={}{0:N2}}"/>
                <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity, StringFormat={}{0:N3}}"/>
                <DataGridTextColumn Header="حد الطلب" Binding="{Binding ReorderPoint, StringFormat={}{0:N3}}"/>
                <DataGridCheckBoxColumn Header="نشط" Binding="{Binding IsActive}"/>
            </DataGrid.Columns>
        </DataGrid>
        <TabControl Grid.Row="3" Margin="0,0,0,10">
            <TabItem Header="بيانات الصنف">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Grid.Column="0" Margin="5"><TextBlock Text="اسم الصنف"/><TextBox Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Grid.Column="1" Margin="5"><TextBlock Text="كود الصنف"/><TextBox Text="{Binding ProductCode, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Grid.Column="2" Margin="5"><TextBlock Text="القسم"/><ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Name"/></StackPanel>
                        <StackPanel Grid.Column="3" Margin="5"><TextBlock Text="الوحدة"/><ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding SelectedUnit}" DisplayMemberPath="Name"/></StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="5"><TextBlock Text="سعر الشراء"/><TextBox Text="{Binding PurchasePrice, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="5"><TextBlock Text="سعر التكلفة"/><TextBox Text="{Binding CostPrice, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="5"><TextBlock Text="سعر البيع"/><TextBox Text="{Binding SellingPrice, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="3" Margin="5"><TextBlock Text="الكمية / الرصيد الافتتاحي"/><TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="4" Margin="5"><TextBlock Text="حد إعادة الطلب"/><TextBox Text="{Binding MinimumStock, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="5"><TextBlock Text="الباركود الرئيسي"/><DockPanel><Button Content="توليد" Command="{Binding GenerateBarcodeCommand}" DockPanel.Dock="Left" Margin="4"/><TextBox Text="{Binding PrimaryBarcode, UpdateSourceTrigger=PropertyChanged}"/></DockPanel></StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="5"><TextBlock Text="باركودات إضافية (افصل بينها بفاصلة)"/><TextBox Text="{Binding SecondaryBarcodes, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <CheckBox Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="2" Content="الصنف نشط" IsChecked="{Binding IsActive}" VerticalAlignment="Center" Margin="8"/>
                        <StackPanel Grid.Row="3" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Left" Margin="5">
                            <Button Content="صنف جديد" Command="{Binding NewProductCommand}" Padding="18,7" Margin="4"/>
                            <Button Content="حفظ الصنف" Command="{Binding SaveProductCommand}" Padding="18,7" Margin="4"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="تسوية / تالف">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="8">
                        <TextBlock Text="تسوية المخزون (فرق الكمية + أو -)" FontWeight="Bold" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding Stores}" SelectedItem="{Binding SelectedStore}" DisplayMemberPath="Name"/>
                        <TextBox Text="{Binding AdjustmentQuantity, UpdateSourceTrigger=PropertyChanged}" ToolTip="فرق الكمية"/>
                        <TextBox Text="{Binding AdjustmentNotes, UpdateSourceTrigger=PropertyChanged}" ToolTip="ملاحظات التسوية"/>
                        <Button Content="تسجيل التسوية" Command="{Binding AdjustStockCommand}" Padding="12,7" Margin="0,6"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8">
                        <TextBlock Text="إخراج مخزون تالف" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding DamagedQuantity, UpdateSourceTrigger=PropertyChanged}" ToolTip="الكمية التالفة"/>
                        <TextBox Text="{Binding DamagedReason, UpdateSourceTrigger=PropertyChanged}" ToolTip="سبب الإخراج"/>
                        <Button Content="تسجيل التالف" Command="{Binding RemoveDamagedStockCommand}" Padding="12,7" Margin="0,6"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
        <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" Foreground="{DynamicResource AccentBrush}" Margin="2"/>
    </Grid>
</UserControl>
