<UserControl x:Class="HeCashier.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid>
        <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="40" MaxWidth="700" MaxHeight="280">
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,20"/>
                <TextBlock Text="{Binding Message}" FontSize="18" TextWrapping="Wrap" Foreground="{DynamicResource ForegroundBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
