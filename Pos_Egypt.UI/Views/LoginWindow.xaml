<Window x:Class="HeCashier.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HeCashier - تسجيل الدخول" Height="430" Width="520" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="48">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="HeCashier" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
            <TextBlock Text="تسجيل الدخول" FontSize="22" HorizontalAlignment="Center" Margin="0,8,0,28"/>
            <TextBlock Text="اسم المستخدم"/>
            <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="كلمة المرور" Margin="0,10,0,0"/>
            <PasswordBox x:Name="PasswordInput" PasswordChanged="PasswordChanged"/>
            <TextBlock Text="{Binding InitialSetupRequiredMessage}" Foreground="{DynamicResource DangerBrush}" Margin="0,8" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" Margin="0,8" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
                <Button Content="خروج" Command="{Binding ExitCommand}" Padding="24,10" Margin="8,0"/>
                <Button Content="دخول" Command="{Binding LoginCommand}" Padding="30,10" Background="{DynamicResource AccentBrush}" Foreground="#101512"/>
            </StackPanel>
            <TextBlock Text="{Binding DevelopmentCredentialsHint}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,22,0,0"/>
        </StackPanel>
    </Grid>
</Window>
