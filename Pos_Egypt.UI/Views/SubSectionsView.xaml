<UserControl x:Class="HeCashier.Views.SubSectionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="الأقسام والوحدات والإعدادات" FontSize="27" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,16"/>
        <TabControl Grid.Row="1">
            <TabItem Header="الأقسام">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
                    <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Name" Margin="5"/>
                    <StackPanel Grid.Column="1" Margin="16">
                        <TextBlock Text="اسم القسم"/><TextBox Text="{Binding CategoryName, UpdateSourceTrigger=PropertyChanged}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10">
                            <Button Content="إضافة / حفظ التعديل" Command="{Binding SaveCategoryCommand}" Padding="14,7" Margin="4"/>
                            <Button Content="حذف القسم" Command="{Binding DeleteCategoryCommand}" Padding="14,7" Margin="4"/>
                        </StackPanel>
                        <TextBlock Text="اختيار قسم من القائمة يسمح بتعديله أو حذفه." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="الوحدات">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
                    <ListBox ItemsSource="{Binding Units}" SelectedItem="{Binding SelectedUnit}" DisplayMemberPath="Name" Margin="5"/>
                    <StackPanel Grid.Column="1" Margin="16">
                        <TextBlock Text="اسم الوحدة"/><TextBox Text="{Binding UnitName, UpdateSourceTrigger=PropertyChanged}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10">
                            <Button Content="إضافة / حفظ التعديل" Command="{Binding SaveUnitCommand}" Padding="14,7" Margin="4"/>
                            <Button Content="حذف الوحدة" Command="{Binding DeleteUnitCommand}" Padding="14,7" Margin="4"/>
                        </StackPanel>
                        <TextBlock Text="لا يمكن حذف وحدة مرتبطة بصنف." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="إعدادات المخزون">
                <StackPanel Margin="24" MaxWidth="700" HorizontalAlignment="Right">
                    <TextBlock Text="البيع والسماح بالمخزون السالب" FontSize="20" FontWeight="Bold" Margin="0,0,0,14"/>
                    <CheckBox Content="السماح بأن تصبح كمية المخزون سالبة" IsChecked="{Binding AllowNegativeStock}" Margin="4,8"/>
                    <TextBlock Text="عند إيقاف هذا الخيار (الإعداد الافتراضي)، تُرفض التسويات والتحويلات وإخراج التالف التي تؤدي إلى كمية سالبة." TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="4,8"/>
                    <Button Content="حفظ الإعدادات" Command="{Binding SaveSettingsCommand}" Padding="18,8" HorizontalAlignment="Right" Margin="4,12"/>
                </StackPanel>
            </TabItem>
        </TabControl>
        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="{DynamicResource AccentBrush}" Margin="4,8"/>
    </Grid>
</UserControl>
