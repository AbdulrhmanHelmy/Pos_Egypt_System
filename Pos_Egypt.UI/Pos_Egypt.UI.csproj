<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HeCashier</RootNamespace>
    <AssemblyName>HeCashier</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\HeCashier.Core\HeCashier.Core.csproj" />
    <ProjectReference Include="..\HeCashier.Infrastructure\HeCashier.Infrastructure.csproj" />
  </ItemGroup>
</Project>
